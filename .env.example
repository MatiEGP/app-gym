# Supabase. Local: run `pnpm supabase:status` and use your PC's LAN IP (not 127.0.0.1).
# Cloud: Project Settings > API in the Supabase dashboard.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.x.x:54321
# Publishable key only (sb_publishable_...). Never the secret or service_role key: EXPO_PUBLIC_* ships in the APK.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
